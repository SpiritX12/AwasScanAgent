# Copy to .env and fill in. Never commit .env.

# Meta Model API key (Standard mode). Base URL is https://api.meta.ai/v1
MODEL_API_KEY=

# Telegram bot token from @BotFather
TELEGRAM_BOT_TOKEN=

# Baseten API key, for Muse Spark Open (meta-models/muse-spark-open-1026)
BASETEN_API_KEY=

# Webhook mode only (Render): any long random string; Telegram must send it back with every update.
# Not needed for local testing with `npm run bot:poll`. Render generates it (see render.yaml).
TELEGRAM_WEBHOOK_SECRET=

# Which model runs the agent: "meta" (Muse Spark 1.3, default) or "baseten" (Muse Spark Open)
AGENT_PROVIDER=meta
