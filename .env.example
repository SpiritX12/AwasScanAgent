# Copy to .env and fill in. Never commit .env.

# Meta Model API key (Standard mode). Base URL is https://api.meta.ai/v1
MODEL_API_KEY=

# Telegram bot token from @BotFather
TELEGRAM_BOT_TOKEN=

# Baseten API key, for Muse Spark Open (meta-models/muse-spark-open-1026)
BASETEN_API_KEY=

# Which model runs the agent: "meta" (Muse Spark 1.3, default) or "baseten" (Muse Spark Open)
AGENT_PROVIDER=meta
